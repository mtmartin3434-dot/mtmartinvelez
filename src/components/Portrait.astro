---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	/** Rendered size in CSS pixels. The file is generated at 2x for retina screens. */
	size?: number;
}

const { src, size = 104 } = Astro.props;
---

<Image
	src={src}
	alt=""
	width={size * 2}
	height={size * 2}
	loading="eager"
	decoding="async"
	class="portrait"
	style={`width:${size}px;height:${size}px`}
/>

<style>
	.portrait {
		/* The face sits in the upper third of the original, so crop from there. */
		object-fit: cover;
		object-position: 50% 38%;
		border-radius: 50%;
		flex-shrink: 0;
		box-shadow: var(--box-shadow);
		/* Softens the circle's edge against the drifting background. */
		border: 3px solid rgb(var(--bg-elevated) / 60%);
	}
</style>
---
import { Picture } from 'astro:assets';
import background from '../assets/wenhao-ruan-SFDk88Wk-Ig-unsplash.jpg';

/**
 * Decorative page background. Rendered as a fixed layer behind everything and
 * covered by a scrim, so body text keeps its contrast over a busy photograph.
 */
---

<div class="background" aria-hidden="true">
	<Picture
		src={background}
		alt=""
		widths={[640, 1024, 1600]}
		sizes="100vw"
		formats={['webp']}
		fallbackFormat="jpg"
		loading="eager"
		decoding="async"
		quality={45}
	/>
	<div class="scrim"></div>
</div>

<style>
	.background {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}
	.background :global(picture),
	.background :global(img) {
		width: 100%;
		height: 100%;
	}
	.background :global(img) {
		object-fit: cover;
		/* The bright sky is in the upper middle; favour the darker canopy below it. */
		object-position: 50% 72%;
		filter: saturate(0.85) contrast(0.95);
	}
	.scrim {
		position: absolute;
		inset: 0;
	}
	@media (prefers-color-scheme: dark) {
		.background :global(img) {
			filter: brightness(0.34) saturate(0.7) blur(2px);
		}
		.scrim {
			background: rgb(0 0 0 / 55%);
		}
	}
	@media (prefers-color-scheme: light) {
		.background :global(img) {
			filter: brightness(1.05) saturate(0.75) blur(3px);
		}
		.scrim {
			background: rgb(255 255 255 / 82%);
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		.background :global(img) {
			/* Barely-there drift, so the page doesn't feel completely static. */
			animation: background-drift 40s ease-in-out infinite alternate;
		}
	}
	@keyframes background-drift {
		from {
			transform: scale(1.04) translateY(-0.6%);
		}
		to {
			transform: scale(1.1) translateY(0.6%);
		}
	}
</style>
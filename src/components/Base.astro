---
import { ClientRouter } from 'astro:transitions';
import { DEFAULT_LOCALE, type Locale } from '../i18n';
import Background from './Background.astro';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Reveal from './Reveal.astro';

interface Props {
	title: string;
	description: string;
	locale?: Locale;
	/** Content width in px. */
	width?: number;
	image?: import('astro').ImageMetadata;
}

const { title, description, locale = DEFAULT_LOCALE, width = 672, image } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} image={image} />
		<ClientRouter />
		<slot name="head" />
	</head>

	<body>
		<Background />
		<Header locale={locale} />
		<main style={`--page-width: ${width}px`}>
			<slot />
		</main>
		<Footer locale={locale} />
		<Reveal />
	</body>
</html>

<style>
	main {
		width: calc(100% - 2em);
		max-width: var(--page-width, 720px);
		margin: 0 auto;
		padding: 1em;
	}
</style>
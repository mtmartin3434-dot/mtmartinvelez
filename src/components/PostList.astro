---
import type { CollectionEntry } from 'astro:content';
import { postSlug } from '../data/posts';
import FormattedDate from './FormattedDate.astro';
import { localizedPath, type Locale } from '../i18n';

interface Props {
	posts: CollectionEntry<'blog'>[];
	locale: Locale;
}

const { posts, locale } = Astro.props;
---

<ul>
	{
		posts.map((post) => (
			<li>
				<a href={localizedPath(locale, `/blog/${postSlug(post)}`)}>
					{post.data.heroImage && (
						<img width={720} height={360} src={post.data.heroImage.src} alt="" />
					)}
					<h4 class="title">{post.data.title}</h4>
					<p class="date">
						<FormattedDate date={post.data.pubDate} locale={locale} />
					</p>
				</a>
			</li>
		))
	}
</ul>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	li {
		width: calc(50% - 1rem);
	}
	li * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	li:first-child {
		width: 100%;
		margin-bottom: 1rem;
		text-align: center;
	}
	li:first-child img {
		width: 100%;
	}
	li:first-child .title {
		font-size: 2.369rem;
	}
	li img {
		margin-bottom: 0.5rem;
		border-radius: 12px;
	}
	li a {
		display: block;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
	}
	li a:hover .title,
	li a:hover .date {
		color: rgb(var(--accent));
	}
	li a:hover img {
		box-shadow: var(--box-shadow);
	}
	@media (max-width: 720px) {
		ul {
			gap: 0.5em;
		}
		li {
			width: 100%;
			text-align: center;
		}
		li:first-child {
			margin-bottom: 0;
		}
		li:first-child .title {
			font-size: 1.563em;
		}
	}
</style>